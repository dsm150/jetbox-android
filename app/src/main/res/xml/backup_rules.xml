<?xml version="1.0" encoding="utf-8"?>
<!--
   JetBox: Android 11 и старше. Бэкап и так выключен (allowBackup="false" в манифесте); правила — на
   случай, если флаг когда-нибудь включат: личность устройства и токен приложения не копируются никуда.
   Android 12+ — data_extraction_rules.xml. Проверка — ManifestTest.noBackupOrDeviceTransfer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
