<?xml version="1.0" encoding="utf-8"?>
<!--
   JetBox: ни облачного бэкапа, ни переноса на новый телефон (Android 12+). В приватных файлах —
   личность устройства (ключ WireGuard в netbird.cfg, state.json, профиль ядра) и токен приложения
   (SharedPreferences jetbox): на двух телефонах один ключ — один пир на двоих. На новом телефоне
   человек входит по email заново. Проверка — ManifestTest.noBackupOrDeviceTransfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
