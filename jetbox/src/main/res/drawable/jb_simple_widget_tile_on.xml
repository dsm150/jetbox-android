<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка с домом виджета «простое» (on): скругление 32 % стороны, дом — 46 %. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jb_simple_accent" />
            <corners android:radius="15dp" />
            <size android:width="46dp" android:height="46dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/jb_simple_house_white" android:gravity="center" android:width="22dp" android:height="22dp" />
</layer-list>
