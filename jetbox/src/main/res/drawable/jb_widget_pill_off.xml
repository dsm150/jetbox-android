<?xml version="1.0" encoding="utf-8"?>
<!-- Переключатель-капсула pillLabel (iOS): 54×30, белый кружок с отступом 3. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jb_widget_gray" />
            <corners android:radius="15dp" />
            <size android:width="54dp" android:height="30dp" />
        </shape>
    </item>
    <item android:gravity="start|center_vertical" android:start="3dp" android:width="24dp" android:height="24dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
