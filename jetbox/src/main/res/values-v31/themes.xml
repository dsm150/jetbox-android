<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: системная заставка — фон JetBox без иконки (iOS UILaunchScreen: только цвет фона).
    Остальное — как в values/themes.xml.
-->
<resources>
    <style name="Theme.JetBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/jb_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/jb_window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/jb_transparent</item>
    </style>
</resources>
