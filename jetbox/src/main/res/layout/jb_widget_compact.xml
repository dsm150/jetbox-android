<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2×1 / 4×1 (у iOS такого нет): знак и текст в строку; касание по всему виджету. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jb_widget_background"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:layout_width="39dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/jb_mark" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/jb_widget_title"
            android:textColor="@color/jb_widget_title"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/jb_widget_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/jb_widget_dot_disconnected" />

            <TextView
                android:id="@+id/jb_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/jb_widget_state_disconnected"
                android:textColor="@color/jb_widget_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
