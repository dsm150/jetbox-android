<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2×1 / 4×1 стиля «простое» (у iOS такого нет): плитка и текст в строку, без тумблера. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jb_simple_widget_background"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/jb_widget_tile"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/jb_simple_widget_tile_off" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/jb_widget_title"
            android:textColor="@color/jb_simple_ink"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/jb_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/jb_widget_state_disconnected"
            android:textColor="@color/jb_simple_muted"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
