<?xml version="1.0" encoding="utf-8"?>
<!-- Средний виджет стиля «простое» (SimpleWidgetView iOS, systemMedium): плитка, текст, тумблер справа. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jb_simple_widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/jb_widget_tile"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:importantForAccessibility="no"
        android:src="@drawable/jb_simple_widget_tile_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/jb_widget_title"
            android:textColor="@color/jb_simple_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/jb_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/jb_widget_state_disconnected"
            android:textColor="@color/jb_simple_muted"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/jb_widget_pill"
        android:layout_width="64dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/jb_simple_widget_pill_off" />
</LinearLayout>
