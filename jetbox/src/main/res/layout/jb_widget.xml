<?xml version="1.0" encoding="utf-8"?>
<!--
    Малый виджет — SmallWidgetView (iOS): знак, состояние, капсула-переключатель; «JetBox» под знаком
    заменяет подпись под виджетом, которую iOS рисует на рабочем столе, а Android — нет.
    Корень — @android:id/background: Android 12+ строит от него анимацию запуска и скругление.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jb_widget_background"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/jb_mark" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/jb_widget_title"
        android:textColor="@color/jb_widget_title"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/jb_widget_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/jb_widget_dot_disconnected" />

            <TextView
                android:id="@+id/jb_widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/jb_widget_state_disconnected"
                android:textColor="@color/jb_widget_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/jb_widget_pill"
        android:layout_width="54dp"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/jb_widget_pill_off" />
</LinearLayout>
